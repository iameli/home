#!/usr/bin/env python3

import sys
import itertools

def main():
    if len(sys.argv) < 2:
        print("Usage: perms <item1> <item2> ...")
        sys.exit(1)
    
    items = sys.argv[1:]
    
    # Generate all permutations of all lengths
    for length in range(1, len(items) + 1):
        for perm in itertools.permutations(items, length):
            print(''.join(perm))

if __name__ == "__main__":
    main()
